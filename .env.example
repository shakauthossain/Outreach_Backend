# Application Settings
APP_NAME="NH Outreach Agent API"
APP_VERSION="2.0.0"
DEBUG=false
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=false

# Security (REQUIRED)
SECRET_KEY=your-secret-key-here-minimum-32-characters-long-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
ALLOWED_ORIGINS=["https://outreach.hellonotionhive.com"]
ALLOW_CREDENTIALS=true

# Database (REQUIRED)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nh_outreach

# Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=true
DB_ECHO=false

# Redis (REQUIRED)
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_DECODE_RESPONSES=true
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Celery (REQUIRED)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540
CELERY_TASK_ACKS_LATE=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# Cache TTL (seconds)
CACHE_TTL_LEADS=120
CACHE_TTL_STATISTICS=300
CACHE_TTL_INBOX=180
CACHE_TTL_PAGESPEED=86400
CACHE_TTL_SCRAPING=21600

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SPEEDTEST=10/minute
RATE_LIMIT_MAIL_GENERATE=20/hour
RATE_LIMIT_RECOMMENDATIONS=10/minute
RATE_LIMIT_PUNCHLINES=15/hour
RATE_LIMIT_UPLOAD=5/minute

# Google PageSpeed API (REQUIRED)
PAGESPEED_API_KEY=your-pagespeed-api-key
PAGESPEED_API_URL=https://www.googleapis.com/pagespeedonline/v5/runPagespeed
PAGESPEED_TIMEOUT=120

# GoHighLevel API (REQUIRED)
GHL_API_KEY=your-ghl-api-key
GHL_API_BASE_URL=https://rest.gohighlevel.com/v1
GHL_LOCATION_ID=your-location-id
GHL_TIMEOUT=30

# SendGrid Email (REQUIRED)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=NH Outreach

# Firecrawl API (REQUIRED)
FIRECRAWL_API_KEY=your-firecrawl-api-key
FIRECRAWL_API_URL=https://api.firecrawl.dev/v0/scrape
FIRECRAWL_TIMEOUT=45

# LLM Providers (REQUIRED)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT=60

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_TIMEOUT=60

DEFAULT_LLM_PROVIDER=gemini

# File Upload
UPLOAD_DIR=./uploaded_csvs
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=[".csv"]

# Screenshots
SCREENSHOT_DIR=./static
SCREENSHOT_TIMEOUT=30000
SCREENSHOT_QUALITY=80

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500
